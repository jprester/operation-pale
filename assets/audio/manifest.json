      "sourceService": "ElevenLabs",
      "version": 1,
      "approval": "awaiting paid-take approval",
      "outputPath": "assets/audio/voices/narrator/final-staging-06-v001.wav",
      "originalPath": null,
      "gainDb": 0,
      "fadeInSeconds": 0,
      "fadeOutSeconds": 0,
      "license": null
    },
    {
      "id": "final-staging-07",
      "scene": "final-staging",
      "speaker": "narrator",
      "text": "At Gamma, another assembly took shape around precision components drawn from a finite stock.",
      "startSeconds": 256,
      "endSeconds": 261.957,
      "targetDurationSeconds": 5.957,
      "characters": 92,
      "estimatedBaseCredits": 92,
      "voiceId": "6FiCmD8eY5VyjOdG5Zjk",
