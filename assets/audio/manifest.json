      "originalPath": null,
      "gainDb": 0,
      "fadeInSeconds": 0,
      "fadeOutSeconds": 0,
      "license": null
    },
    {
      "id": "final-staging-06",
      "scene": "final-staging",
      "speaker": "narrator",
      "text": "Asteroids supplied metal. Compact fusion systems and high-grade seekers came from home.",
      "startSeconds": 249,
      "endSeconds": 255.072,
      "targetDurationSeconds": 6.072,
      "characters": 87,
      "estimatedBaseCredits": 87,
      "voiceId": "6FiCmD8eY5VyjOdG5Zjk",
      "model": null,
