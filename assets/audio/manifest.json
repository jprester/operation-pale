      "originalPath": null,
      "gainDb": 0,
      "fadeInSeconds": 0,
      "fadeOutSeconds": 0,
      "license": null
    },
    {
      "id": "final-staging-05",
      "scene": "final-staging",
      "speaker": "narrator",
      "text": "Wardens coordinated traffic in orbit. Far below them, Lanterns sensed and relayed from the stratosphere.",
      "startSeconds": 242,
      "endSeconds": 248.72,
      "targetDurationSeconds": 6.72,
      "characters": 104,
      "estimatedBaseCredits": 104,
      "voiceId": "6FiCmD8eY5VyjOdG5Zjk",
      "model": null,
